# Agent-environment scaffolding (the `skills/` tree is mounted by the
# development sandbox, not part of the glyim repo) and one-off delivery
# tooling (the ship.toml + zip generators): excluded from the ship.toml
# union check so `ship validate` does not flag them as dirty-but-unlisted.
skills/
scripts/gen_ship_toml.py
scripts/build_ship_zip.py

# Agent-sandbox scaffolding (download/ is the sandbox deliverable dir)
download/

# Ship manifest + PR body (AI delivery artifacts; ship validate runs on a dirty tree)
ship.toml
