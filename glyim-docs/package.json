{
  "name": "glyim-docs",
  "version": "0.6.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFails error",
    "lint": "docs-toolkit-lint",
    "qa:components": "docs-toolkit-qa-components",
    "qa": "docs-toolkit-qa-screenshots",
    "lint:code": "./node_modules/@elcoosp/docs-toolkit/node_modules/.bin/oxlint -c ./node_modules/@elcoosp/docs-toolkit/.oxlintrc.json",
    "fmt": "./node_modules/@elcoosp/docs-toolkit/node_modules/.bin/oxfmt -c ./node_modules/@elcoosp/docs-toolkit/.oxfmtrc.json '**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}'",
    "fmt:check": "./node_modules/@elcoosp/docs-toolkit/node_modules/.bin/oxfmt -c ./node_modules/@elcoosp/docs-toolkit/.oxfmtrc.json --check '**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}'"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@elcoosp/docs-toolkit": "^1.6.7",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0"
}
